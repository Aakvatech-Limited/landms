{
 "doctype": "DocType",
 "name": "Plot Contract",
 "module": "LandMS",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "is_submittable": 1,
 "track_changes": 1,
 "engine": "InnoDB",
 "field_order": [
  "naming_series",
  "contract_section",
  "customer",
  "plot",
  "land_acquisition",
  "acquisition_name",
  "contract_date",
  "col_break_1",
  "contract_status",
  "payment_deadline",
  "payment_completion_days",
  "apply_auto_cancellation",
  "control_number",
  "tab_financials",
  "financials_section",
  "selling_price",
  "booking_fee_percent",
  "booking_fee_amount",
  "col_break_2",
  "government_share_percent",
  "government_fee_withheld",
  "balance_due",
  "payment_summary_section",
  "total_contract_value",
  "total_paid",
  "col_break_3",
  "total_outstanding",
  "payment_progress",
  "tab_payments",
  "payment_schedule_section",
  "payment_schedule",
  "tab_references",
  "references_section",
  "sales_order",
  "plot_application",
  "col_break_refs",
  "booking_fee_invoice",
  "government_fee_entry",
  "forfeiture_entry",
  "notes_section",
  "notes",
  "termination_reason",
  "linked_documents_section",
  "linked_documents_html",
  "amended_from"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "CTR-.YYYY.-.####"
  },
  {
   "fieldname": "contract_section",
   "fieldtype": "Section Break",
   "label": "Contract Details"
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Customer",
   "options": "Customer",
   "in_list_view": 1,
   "reqd": 1,
   "bold": 1
  },
  {
   "fieldname": "plot",
   "fieldtype": "Link",
   "label": "Plot",
   "options": "Plot Master",
   "in_list_view": 1,
   "reqd": 1,
   "bold": 1
  },
  {
   "fieldname": "land_acquisition",
   "fieldtype": "Link",
   "label": "Land Acquisition",
   "options": "Land Acquisition",
   "read_only": 1
  },
  {
   "fieldname": "acquisition_name",
   "fieldtype": "Data",
   "label": "Acquisition Name",
   "read_only": 1
  },
  {
   "fieldname": "contract_date",
   "fieldtype": "Date",
   "label": "Contract Date",
   "in_list_view": 1,
   "reqd": 1
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "contract_status",
   "fieldtype": "Select",
   "label": "Contract Status",
   "options": "Draft\nOngoing\nOverdue\nCompleted\nCancelled\nTerminated",
   "default": "Draft",
   "in_standard_filter": 1,
   "in_list_view": 1,
   "read_only": 1,
   "bold": 1
  },
  {
   "fieldname": "payment_deadline",
   "fieldtype": "Date",
   "label": "Payment Deadline",
   "read_only": 1,
   "bold": 1
  },
  {
   "fieldname": "payment_completion_days",
   "fieldtype": "Int",
   "label": "Payment Completion Days",
   "default": "90",
   "read_only": 1
  },
  {
   "fieldname": "apply_auto_cancellation",
   "fieldtype": "Check",
   "label": "Apply Auto-Cancellation",
   "default": "1",
   "description": "Inherited from Sales Order. Uncheck to allow payment beyond deadline."
  },
  {
   "fieldname": "control_number",
   "fieldtype": "Data",
   "label": "TCB Control Number",
   "read_only": 1
  },
  {
   "fieldname": "tab_financials",
   "fieldtype": "Tab Break",
   "label": "Financials"
  },
  {
   "fieldname": "financials_section",
   "fieldtype": "Section Break",
   "label": "Price Breakdown"
  },
  {
   "fieldname": "selling_price",
   "fieldtype": "Currency",
   "label": "Selling Price (TZS)",
   "read_only": 1,
   "bold": 1
  },
  {
   "fieldname": "booking_fee_percent",
   "fieldtype": "Percent",
   "label": "Booking Fee %",
   "read_only": 1
  },
  {
   "fieldname": "booking_fee_amount",
   "fieldtype": "Currency",
   "label": "Booking Fee Amount (TZS)",
   "read_only": 1
  },
  {
   "fieldname": "col_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "government_share_percent",
   "fieldtype": "Percent",
   "label": "Government Share %",
   "read_only": 1
  },
  {
   "fieldname": "government_fee_withheld",
   "fieldtype": "Currency",
   "label": "Expected Government Fee (TZS)",
   "read_only": 1
  },
  {
   "fieldname": "balance_due",
   "fieldtype": "Currency",
   "label": "Balance Due (TZS)",
   "read_only": 1
  },
  {
   "fieldname": "payment_summary_section",
   "fieldtype": "Section Break",
   "label": "Payment Summary"
  },
  {
   "fieldname": "total_contract_value",
   "fieldtype": "Currency",
   "label": "Total Contract Value (TZS)",
   "read_only": 1,
   "bold": 1
  },
  {
   "fieldname": "total_paid",
   "fieldtype": "Currency",
   "label": "Total Paid (TZS)",
   "read_only": 1,
   "bold": 1
  },
  {
   "fieldname": "col_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "total_outstanding",
   "fieldtype": "Currency",
   "label": "Total Outstanding (TZS)",
   "read_only": 1,
   "bold": 1
  },
  {
   "fieldname": "payment_progress",
   "fieldtype": "Select",
   "label": "Payment Progress",
   "options": "Unpaid\nAdvance Paid\nAdvance + Installments Paid\nFully Paid\nPartially Paid",
   "default": "Unpaid",
   "in_list_view": 1,
   "read_only": 1
  },
  {
   "fieldname": "tab_payments",
   "fieldtype": "Tab Break",
   "label": "Payment Schedule"
  },
  {
   "fieldname": "payment_schedule_section",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "payment_schedule",
   "fieldtype": "Table",
   "label": "Payment Schedule",
   "options": "Plot Contract Payment",
   "read_only": 1
  },
  {
   "fieldname": "tab_references",
   "fieldtype": "Tab Break",
   "label": "More Info"
  },
  {
   "fieldname": "references_section",
   "fieldtype": "Section Break",
   "label": "Linked Documents"
  },
  {
   "fieldname": "sales_order",
   "fieldtype": "Link",
   "label": "Sales Order",
   "options": "Sales Order",
   "read_only": 1
  },
  {
   "fieldname": "plot_application",
   "fieldtype": "Link",
   "label": "Plot Application",
   "options": "Plot Application",
   "read_only": 1
  },
  {
   "fieldname": "col_break_refs",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "booking_fee_invoice",
   "fieldtype": "Link",
   "label": "Plot Sales Invoice",
   "options": "Sales Invoice",
   "read_only": 1
  },
  {
   "fieldname": "government_fee_entry",
   "fieldtype": "Link",
   "label": "Government Fee Journal Entry",
   "options": "Journal Entry",
   "read_only": 1,
   "depends_on": "eval:doc.government_fee_entry"
  },
  {
   "fieldname": "forfeiture_entry",
   "fieldtype": "Link",
   "label": "Forfeiture Journal Entry",
   "options": "Journal Entry",
   "read_only": 1,
   "depends_on": "eval:doc.forfeiture_entry"
  },
  {
   "fieldname": "notes_section",
   "fieldtype": "Section Break",
   "label": "Notes"
  },
  {
   "fieldname": "notes",
   "fieldtype": "Long Text",
   "label": "Notes"
  },
  {
   "fieldname": "termination_reason",
   "fieldtype": "Long Text",
   "label": "Termination Reason",
   "read_only": 1,
   "depends_on": "eval:doc.termination_reason"
  },
  {
   "fieldname": "linked_documents_section",
   "fieldtype": "Section Break",
   "label": "Document Links"
  },
  {
   "fieldname": "linked_documents_html",
   "fieldtype": "HTML",
   "label": "Linked Documents"
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "Amended From",
   "options": "Plot Contract",
   "no_copy": 1,
   "print_hide": 1,
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "Sales User",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "Accounts User",
   "read": 1
  }
 ],
 "states": [
  {"title": "Draft", "color": "Gray"},
  {"title": "Ongoing", "color": "Yellow"},
  {"title": "Overdue", "color": "Red"},
  {"title": "Completed", "color": "Green"},
  {"title": "Cancelled", "color": "Red"},
  {"title": "Terminated", "color": "Orange"}
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}
