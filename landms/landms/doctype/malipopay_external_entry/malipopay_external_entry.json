{
 "doctype": "DocType",
 "name": "Malipopay External Entry",
 "module": "LandMS",
 "issingle": 0,
 "is_submittable": 0,
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "title_field": "external_reference",
 "sort_field": "creation",
 "sort_order": "DESC",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "MPX-.YYYY.-.#####",
   "default": "MPX-.YYYY.-.#####",
   "reqd": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Queued\nSent\nReplayed\nRefused\nFailed",
   "default": "Queued",
   "reqd": 1,
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "entry_type",
   "fieldtype": "Select",
   "label": "Type",
   "options": "CREDIT\nDEBIT",
   "reqd": 1,
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "CREDIT tells Malipopay we received money on this bill outside Malipopay; DEBIT reverses an earlier CREDIT."
  },
  {
   "fieldname": "amount",
   "fieldtype": "Int",
   "label": "Amount (TZS)",
   "reqd": 1,
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "external_reference",
   "fieldtype": "Data",
   "label": "External Reference",
   "reqd": 1,
   "read_only": 1,
   "unique": 1,
   "in_list_view": 1,
   "description": "Idempotency key sent to Malipopay. Fixed at insert; a retry resends the same key so Malipopay replays instead of posting twice."
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "malipopay_collection",
   "fieldtype": "Link",
   "label": "Malipopay Collection",
   "options": "Malipopay Collection",
   "reqd": 1,
   "read_only": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "sales_order",
   "fieldtype": "Link",
   "label": "Sales Order",
   "options": "Sales Order",
   "read_only": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "payment_entry",
   "fieldtype": "Link",
   "label": "Payment Entry",
   "options": "Payment Entry",
   "read_only": 1,
   "in_standard_filter": 1,
   "description": "The payment taken outside Malipopay that this entry reports (or reverses)."
  },
  {
   "fieldname": "ml_reference",
   "fieldtype": "Data",
   "label": "Malipopay Reference",
   "read_only": 1
  },
  {
   "fieldname": "control_number",
   "fieldtype": "Data",
   "label": "Control Number",
   "read_only": 1
  },
  {
   "fieldname": "sec_request",
   "fieldtype": "Section Break",
   "label": "What was sent"
  },
  {
   "fieldname": "source",
   "fieldtype": "Data",
   "label": "Source",
   "read_only": 1
  },
  {
   "fieldname": "paid_at",
   "fieldtype": "Datetime",
   "label": "Paid At",
   "read_only": 1
  },
  {
   "fieldname": "trigger",
   "fieldtype": "Data",
   "label": "Triggered By",
   "read_only": 1
  },
  {
   "fieldname": "col_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description",
   "read_only": 1
  },
  {
   "fieldname": "reason",
   "fieldtype": "Small Text",
   "label": "Reason",
   "read_only": 1
  },
  {
   "fieldname": "sec_response",
   "fieldtype": "Section Break",
   "label": "What came back"
  },
  {
   "fieldname": "attempts",
   "fieldtype": "Int",
   "label": "Attempts",
   "default": "0",
   "read_only": 1
  },
  {
   "fieldname": "last_attempt_at",
   "fieldtype": "Datetime",
   "label": "Last Attempt At",
   "read_only": 1
  },
  {
   "fieldname": "http_status",
   "fieldtype": "Int",
   "label": "HTTP Status",
   "read_only": 1
  },
  {
   "fieldname": "provider_code",
   "fieldtype": "Data",
   "label": "Provider Code",
   "read_only": 1
  },
  {
   "fieldname": "col_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "entry_id",
   "fieldtype": "Data",
   "label": "Malipopay Entry ID",
   "read_only": 1
  },
  {
   "fieldname": "outstanding_after",
   "fieldtype": "Int",
   "label": "Outstanding After (TZS)",
   "read_only": 1
  },
  {
   "fieldname": "external_paid_after",
   "fieldtype": "Int",
   "label": "External Paid After (TZS)",
   "read_only": 1
  },
  {
   "fieldname": "message",
   "fieldtype": "Small Text",
   "label": "Message",
   "read_only": 1
  }
 ],
 "field_order": [
  "naming_series",
  "status",
  "entry_type",
  "amount",
  "external_reference",
  "col_break_1",
  "malipopay_collection",
  "sales_order",
  "payment_entry",
  "ml_reference",
  "control_number",
  "sec_request",
  "source",
  "paid_at",
  "trigger",
  "col_break_2",
  "description",
  "reason",
  "sec_response",
  "attempts",
  "last_attempt_at",
  "http_status",
  "provider_code",
  "col_break_3",
  "entry_id",
  "outstanding_after",
  "external_paid_after",
  "message"
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1,
   "export": 1
  },
  {
   "role": "Accounts Manager",
   "read": 1,
   "report": 1
  },
  {
   "role": "Accounts User",
   "read": 1,
   "report": 1
  }
 ]
}