{
 "doctype": "DocType",
 "name": "Malipopay Webhook Event",
 "module": "LandMS",
 "issingle": 0,
 "is_submittable": 0,
 "track_changes": 1,
 "autoname": "format:MPW-{transaction_id}",
 "naming_rule": "Expression",
 "title_field": "transaction_id",
 "sort_field": "received_at",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "event_type",
   "fieldtype": "Select",
   "label": "Event Type",
   "options": "payment.confirmed\npayment.failed\npayment.refunded\nunknown",
   "default": "unknown",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "processing_status",
   "fieldtype": "Select",
   "label": "Processing Status",
   "options": "Pending\nProcessed\nIgnored\nDuplicate\nRejected\nHeld\nFailed",
   "default": "Pending",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Malipopay delivers each webhook exactly ONCE (no retry) — this row is therefore the durable inbox AND the retry mechanism: the repair job re-processes anything left Pending or Failed. 'Rejected' = HMAC signature failed (persisted for forensics, never processed into money). 'Held' = needs a human (refunds, dead references)."
  },
  {
   "fieldname": "received_at",
   "fieldtype": "Datetime",
   "label": "Received At",
   "reqd": 1,
   "in_list_view": 1,
   "read_only": 1
  },
  {
   "fieldname": "col_break_header",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "hmac_verified",
   "fieldtype": "Check",
   "label": "HMAC Verified",
   "default": "0",
   "read_only": 1,
   "description": "X-Malipopay-Signature verified as HMAC-SHA256 over the RAW request bytes. Unverified events are never processed."
  },
  {
   "fieldname": "attempts",
   "fieldtype": "Int",
   "label": "Processing Attempts",
   "default": "0",
   "read_only": 1
  },
  {
   "fieldname": "source_ip",
   "fieldtype": "Data",
   "label": "Source IP",
   "read_only": 1
  },
  {
   "fieldname": "identifiers_section",
   "fieldtype": "Section Break",
   "label": "Identifiers"
  },
  {
   "fieldname": "transaction_id",
   "fieldtype": "Data",
   "label": "Malipopay Transaction ID",
   "reqd": 1,
   "unique": 1,
   "search_index": 1,
   "in_standard_filter": 1,
   "no_copy": 1,
   "description": "Their stable transactionId — the contractual dedupe key. Also forms the document name (MPW-...), so duplicate deliveries fail at the database, not in racy application code."
  },
  {
   "fieldname": "control_number",
   "fieldtype": "Data",
   "label": "Control Number (customerReference)",
   "search_index": 1,
   "read_only": 1
  },
  {
   "fieldname": "col_break_identifiers",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "ml_reference",
   "fieldtype": "Data",
   "label": "Malipopay Reference (ML...)",
   "search_index": 1,
   "read_only": 1
  },
  {
   "fieldname": "cumulative_amount",
   "fieldtype": "Currency",
   "label": "Cumulative Amount (as received)",
   "read_only": 1,
   "description": "The webhook 'amount' field is the CUMULATIVE total paid on the bill, not this installment. It is stored as a checksum and audit trail only — booking always derives from the fetched per-transaction breakdown, never from this figure."
  },
  {
   "fieldname": "reported_status",
   "fieldtype": "Data",
   "label": "Reported Status",
   "read_only": 1
  },
  {
   "fieldname": "processing_section",
   "fieldtype": "Section Break",
   "label": "Processing Result"
  },
  {
   "fieldname": "malipopay_collection",
   "fieldtype": "Link",
   "label": "Malipopay Collection",
   "options": "Malipopay Collection",
   "read_only": 1
  },
  {
   "fieldname": "payment_entry",
   "fieldtype": "Link",
   "label": "Payment Entry",
   "options": "Payment Entry",
   "read_only": 1
  },
  {
   "fieldname": "col_break_processing",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "processed_at",
   "fieldtype": "Datetime",
   "label": "Processed At",
   "read_only": 1
  },
  {
   "fieldname": "processing_message",
   "fieldtype": "Small Text",
   "label": "Processing Message",
   "read_only": 1
  },
  {
   "fieldname": "error",
   "fieldtype": "Long Text",
   "label": "Error / Traceback",
   "read_only": 1
  },
  {
   "fieldname": "raw_payload_section",
   "fieldtype": "Section Break",
   "label": "Raw Payload",
   "collapsible": 1
  },
  {
   "fieldname": "raw_payload",
   "fieldtype": "Long Text",
   "label": "Raw Payload",
   "read_only": 1,
   "description": "The exact raw request body (the bytes the HMAC signature covers). Committed before the endpoint answers 200 — from that moment the payment notification can be delayed but never lost."
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Accounts Manager",
   "read": 1
  },
  {
   "role": "Accounts User",
   "read": 1
  }
 ]
}
