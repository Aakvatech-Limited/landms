{
 "doctype": "DocType",
 "name": "Plot Master",
 "module": "LandMS",
 "autoname": "naming_series:",
 "is_submittable": 1,
 "track_changes": 1,
 "title_field": "plot_number",
 "search_fields": "plot_number,land_acquisition,acquisition_name,plot_type,status",
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Naming Series",
   "options": "PLT-.YYYY.-.####",
   "default": "PLT-.YYYY.-.####"
  },
  {
   "fieldname": "plot_details_section",
   "fieldtype": "Section Break",
   "label": "Plot Details"
  },
  {
   "fieldname": "land_acquisition",
   "fieldtype": "Link",
   "label": "Land Acquisition",
   "options": "Land Acquisition",
   "reqd": 1,
   "description": "Must be an Approved or Subdivided Land Acquisition"
  },
  {
   "fieldname": "acquisition_name",
   "fieldtype": "Data",
   "label": "Acquisition Name",
   "read_only": 1,
   "fetch_from": "land_acquisition.acquisition_name"
  },
  {
   "fieldname": "plot_number",
   "fieldtype": "Data",
   "label": "Plot Number",
   "reqd": 1,
   "description": "Unique plot identifier within this Land Acquisition (e.g. A-001)"
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "plot_type",
   "fieldtype": "Link",
   "label": "Plot Type",
   "options": "Plot Type",
   "reqd": 1,
   "search_index": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Available\nPending Fee\nPending Advance\nReserved\nReady for Handover\nDelivered\nTitle Closed",
   "default": "Available",
   "read_only": 1
  },
  {
   "fieldname": "plot_size_sqm",
   "fieldtype": "Float",
   "label": "Plot Size (sqm)",
   "reqd": 1
  },
  {
   "fieldname": "col_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "selling_price",
   "fieldtype": "Currency",
   "label": "Selling Price (TZS)",
   "reqd": 1,
   "read_only": 1,
   "description": "Auto-calculated as selling price per sqm multiplied by plot size"
  },
  {
   "fieldname": "booking_fee_percent",
   "fieldtype": "Percent",
   "label": "Booking Fee %",
   "read_only": 1
  },
  {
   "fieldname": "government_share_percent",
   "fieldtype": "Percent",
   "label": "Government Share %",
   "read_only": 1
  },
  {
   "fieldname": "financials_section",
   "fieldtype": "Section Break",
   "label": "Financials",
   "collapsible": 1
  },
  {
   "fieldname": "cost_per_sqm",
   "fieldtype": "Currency",
   "label": "Cost per Sqm (TZS)",
   "read_only": 1,
   "description": "Auto-calculated from Land Acquisition cost divided by total area"
  },
  {
   "fieldname": "selling_price_per_sqm",
   "fieldtype": "Currency",
   "label": "Selling Price per Sqm (TZS)",
   "read_only": 1,
   "description": "Auto-filled from the Land Acquisition rate for this plot type"
  },
  {
   "fieldname": "col_break_financials",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "allocated_cost",
   "fieldtype": "Currency",
   "label": "Allocated Cost (TZS)",
   "read_only": 1,
   "description": "Auto-calculated as cost per sqm multiplied by plot size"
  },
  {
   "fieldname": "payment_completion_days",
   "fieldtype": "Int",
   "label": "Payment Completion Days",
   "read_only": 1
  },
  {
   "fieldname": "no_advance_deadline",
   "fieldtype": "Check",
   "label": "No Advance Deadline",
   "default": "0",
   "allow_on_submit": 1,
   "description": "Customer gets the full payment period, with no separate advance deadline."
  },
  {
   "fieldname": "location_section",
   "fieldtype": "Section Break",
   "label": "Location",
   "collapsible": 1
  },
  {
   "fieldname": "latitude",
   "fieldtype": "Float",
   "label": "Latitude",
   "precision": "6"
  },
  {
   "fieldname": "longitude",
   "fieldtype": "Float",
   "label": "Longitude",
   "precision": "6"
  },
  {
   "fieldname": "col_break_location",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "location_description",
   "fieldtype": "Small Text",
   "label": "Location Description"
  },
  {
   "fieldname": "references_section",
   "fieldtype": "Section Break",
   "label": "System References",
   "collapsible": 1
  },
  {
   "fieldname": "serial_no",
   "fieldtype": "Data",
   "label": "Serial No",
   "read_only": 1,
   "description": "Auto-assigned on submission (equals plot name)"
  },
  {
   "fieldname": "stock_entry",
   "fieldtype": "Link",
   "label": "Stock Entry",
   "options": "Stock Entry",
   "read_only": 1,
   "description": "Material Receipt that moved this plot's value from LUD into Plot Inventory"
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "Amended From",
   "options": "Plot Master",
   "read_only": 1,
   "print_hide": 1
  },
  {
   "fieldname": "govt_fees_section",
   "fieldtype": "Section Break",
   "label": "Government Fees (Informational)"
  },
  {
   "fieldname": "land_rent_rate",
   "fieldtype": "Float",
   "label": "Land Rent Rate (TZS/sqm)",
   "read_only": 1
  },
  {
   "fieldname": "land_rent",
   "fieldtype": "Currency",
   "label": "Land Rent (L/RENT)",
   "read_only": 1
  },
  {
   "fieldname": "registration_prep_fee",
   "fieldtype": "Currency",
   "label": "Registration Prep Fee (CT)",
   "read_only": 1
  },
  {
   "fieldname": "col_break_govt_fees",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "govt_application_fee",
   "fieldtype": "Currency",
   "label": "Govt Application Fee (APPL)",
   "read_only": 1
  },
  {
   "fieldname": "premium",
   "fieldtype": "Currency",
   "label": "Premium",
   "read_only": 1
  },
  {
   "fieldname": "govt_registration_fee",
   "fieldtype": "Currency",
   "label": "Govt Registration Fee (REGISTR)",
   "read_only": 1
  },
  {
   "fieldname": "stamp_duty",
   "fieldtype": "Currency",
   "label": "Stamp Duty",
   "read_only": 1
  },
  {
   "fieldname": "govt_totals_section",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "total_govt_fees",
   "fieldtype": "Currency",
   "label": "Total Government Fees",
   "read_only": 1,
   "bold": 1
  },
  {
   "fieldname": "col_break_totals",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "total_plot_amount",
   "fieldtype": "Currency",
   "label": "Total Amount (CAPS + Govt Fees)",
   "read_only": 1,
   "bold": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "Land Acquisition Approver",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  }
 ]
}
