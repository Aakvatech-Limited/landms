{
 "doctype": "DocType",
 "name": "Malipopay API Log",
 "module": "LandMS",
 "issingle": 0,
 "is_submittable": 0,
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "title_field": "event_type",
 "sort_field": "requested_at",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "MPAY-LOG-.YYYY.-.######",
   "default": "MPAY-LOG-.YYYY.-.######",
   "reqd": 1
  },
  {
   "fieldname": "direction",
   "fieldtype": "Select",
   "label": "Direction",
   "options": "Outbound\nInbound",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "event_type",
   "fieldtype": "Select",
   "label": "Event Type",
   "options": "Collection Create\nCollection Query\nBreakdown\nVerify\nWebhook\nSweep\nStatus Poll\nExpire\nSuspend\nResume\nExternal Receipt",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Success\nFailed\nIgnored\nStopped",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "col_break_header",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "processing_mode",
   "fieldtype": "Data",
   "label": "Processing Mode",
   "description": "Free text context: Off, Log Only, Live, Apply Payment, Started, Completed, Exception, Sweep Summary, Form Action, ..."
  },
  {
   "fieldname": "requested_at",
   "fieldtype": "Datetime",
   "label": "Requested At"
  },
  {
   "fieldname": "response_at",
   "fieldtype": "Datetime",
   "label": "Response At"
  },
  {
   "fieldname": "http_status_code",
   "fieldtype": "Int",
   "label": "HTTP Status Code"
  },
  {
   "fieldname": "identifiers_section",
   "fieldtype": "Section Break",
   "label": "Identifiers"
  },
  {
   "fieldname": "endpoint",
   "fieldtype": "Data",
   "label": "Endpoint",
   "length": 255,
   "description": "API endpoint hit (secrets never appear — the apiToken travels in a header, not the URL)."
  },
  {
   "fieldname": "control_number",
   "fieldtype": "Data",
   "label": "Control Number",
   "search_index": 1,
   "read_only": 1
  },
  {
   "fieldname": "ml_reference",
   "fieldtype": "Data",
   "label": "Malipopay Reference (ML...)",
   "search_index": 1,
   "read_only": 1
  },
  {
   "fieldname": "col_break_identifiers",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "transaction_id",
   "fieldtype": "Data",
   "label": "Transaction ID",
   "search_index": 1
  },
  {
   "fieldname": "sales_order",
   "fieldtype": "Link",
   "label": "Sales Order",
   "options": "Sales Order",
   "read_only": 1
  },
  {
   "fieldname": "malipopay_collection",
   "fieldtype": "Link",
   "label": "Malipopay Collection",
   "options": "Malipopay Collection",
   "read_only": 1
  },
  {
   "fieldname": "payment_entry",
   "fieldtype": "Link",
   "label": "Payment Entry",
   "options": "Payment Entry",
   "read_only": 1
  },
  {
   "fieldname": "payload_section",
   "fieldtype": "Section Break",
   "label": "Payloads",
   "collapsible": 1
  },
  {
   "fieldname": "request_payload",
   "fieldtype": "Long Text",
   "label": "Request Payload"
  },
  {
   "fieldname": "response_payload",
   "fieldtype": "Long Text",
   "label": "Response Payload"
  },
  {
   "fieldname": "error",
   "fieldtype": "Long Text",
   "label": "Error / Traceback"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Accounts Manager",
   "read": 1
  },
  {
   "role": "Accounts User",
   "read": 1
  },
  {
   "role": "Sales Manager",
   "read": 1
  },
  {
   "role": "Sales User",
   "read": 1
  }
 ]
}
