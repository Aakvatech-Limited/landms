{
 "doctype": "DocType",
 "name": "TCB Reconciliation Log",
 "module": "LandMS",
 "issingle": 0,
 "is_submittable": 0,
 "track_changes": 0,
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "title_field": "status",
 "sort_field": "started_at",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "TCB-RECON-.YYYY.-.######",
   "default": "TCB-RECON-.YYYY.-.######",
   "reqd": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nRunning\nSuccess\nPartial\nFailed\nStopped",
   "default": "Draft",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "bold": 1,
   "read_only": 1
  },
  {
   "fieldname": "triggered_by",
   "fieldtype": "Select",
   "label": "Triggered By",
   "options": "Manual\nScheduled",
   "default": "Manual",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "header_col_break",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "started_at",
   "fieldtype": "Datetime",
   "label": "Started At",
   "in_list_view": 1,
   "read_only": 1
  },
  {
   "fieldname": "completed_at",
   "fieldtype": "Datetime",
   "label": "Completed At",
   "read_only": 1
  },
  {
   "fieldname": "duration_seconds",
   "fieldtype": "Float",
   "label": "Duration (s)",
   "precision": "2",
   "read_only": 1
  },
  {
   "fieldname": "stop_requested",
   "fieldtype": "Check",
   "label": "Stop Requested",
   "read_only": 1
  },
  {
   "fieldname": "stop_requested_at",
   "fieldtype": "Datetime",
   "label": "Stop Requested At",
   "read_only": 1,
   "depends_on": "eval:doc.stop_requested"
  },
  {
   "fieldname": "stop_requested_by",
   "fieldtype": "Link",
   "label": "Stop Requested By",
   "options": "User",
   "read_only": 1,
   "depends_on": "eval:doc.stop_requested"
  },
  {
   "fieldname": "date_range_section",
   "fieldtype": "Section Break",
   "label": "Date Range"
  },
  {
   "fieldname": "date_range_start",
   "fieldtype": "Date",
   "label": "From Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "date_range_col_break",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "date_range_end",
   "fieldtype": "Date",
   "label": "To Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "results_section",
   "fieldtype": "Section Break",
   "label": "Results",
   "depends_on": "eval:doc.status !== 'Draft'"
  },
  {
   "fieldname": "total_rows",
   "fieldtype": "Int",
   "label": "Total Rows",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "applied",
   "fieldtype": "Int",
   "label": "Applied",
   "read_only": 1,
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "results_col_break",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "ignored",
   "fieldtype": "Int",
   "label": "Ignored / Skipped",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "failed",
   "fieldtype": "Int",
   "label": "Failed Rows",
   "read_only": 1,
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "message",
   "fieldtype": "Small Text",
   "label": "Message",
   "read_only": 1,
   "depends_on": "eval:doc.message"
  },
  {
   "fieldname": "rows_section",
   "fieldtype": "Section Break",
   "label": "Payment Rows",
   "depends_on": "eval:doc.status !== 'Draft' && doc.rows && doc.rows.length > 0"
  },
  {
   "fieldname": "rows",
   "fieldtype": "Table",
   "label": "Payment Rows",
   "options": "TCB Reconciliation Log Row",
   "read_only": 1,
   "description": "One row per payment returned from TCB. Shows what was applied, ignored, and failed."
  },
  {
   "fieldname": "error_section",
   "fieldtype": "Section Break",
   "label": "Error",
   "depends_on": "eval:doc.status === 'Failed' && doc.error"
  },
  {
   "fieldname": "error",
   "fieldtype": "Long Text",
   "label": "Error / Traceback",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "Accounts Manager",
   "read": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "Accounts User",
   "read": 1
  }
 ],
 "states": [
  {"title": "Draft",   "color": "Gray"},
  {"title": "Running", "color": "Blue"},
  {"title": "Success", "color": "Green"},
  {"title": "Partial", "color": "Yellow"},
  {"title": "Failed",  "color": "Red"},
  {"title": "Stopped", "color": "Orange"}
 ]
}
